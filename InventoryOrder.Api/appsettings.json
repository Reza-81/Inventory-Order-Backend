{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Seed": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ]
  },
  "Jwt": {
    "Issuer": "InventoryOrder.Api",
    "Audience": "InventoryOrder.Client",
    "SigningKey": "development-only-change-this-signing-key-please-1234567890",
    "LifetimeMinutes": 60
  },
  "ConnectionStrings": {
    "MySql": "Server=localhost;Port=3306;Database=inventory;User=inventory_app;Password=inventory_password",
    "Redis": "localhost:6379"
  }
}
